email=your_quotex_email@gmail.com
password=your_quotex_password
timezone=UTC+6

# kotokkhon-er data save thakbe (minute). 10 = last 10 minute
RETENTION_MINUTES=10
# raw tick-o save korte chaile true
SAVE_TICKS=true
# ALL = payout onujayi top open market, ba nije dao: EURUSD_otc,GBPUSD_otc
STREAM_SYMBOLS=ALL
MAX_STREAMS=30
PAYOUT_REFRESH_SEC=20

# Public server-e dile obosshoi dao: request-e ?key=... ba header X-API-Key lagbe
API_KEY=
